[run]
source = .
omit =
    */tests/*
    */test_*
    */__pycache__/*
    */.venv/*
    */venv/*
    */.pytest_cache/*
    */htmlcov/*
    setup.py
    scripts/migrate_to_cache.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    def __str__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    @abc.abstractmethod
    
precision = 2
show_missing = True
skip_covered = False

[html]
directory = htmlcov
title = NSA Coverage Report
